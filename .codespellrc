[codespell]
# All false positives, and codespell only sees the files a commit touches — so
# each one lies dormant until someone edits that file, then fails CI on main.
#   notin                  Kubernetes label-selector operator (matchExpressions)
#   hass                   Home Assistant, in dashboards and authentik blueprints
#   nd                     Grafana/JSON field fragments
#   alle als ist lief maschine negativ oder positiv sie tage
#                          German strings in the Grafana dashboards
#   re-use                 gotk-components.yaml; super-linter passes it by path, so
#                          the skip below does not reach it
ignore-words-list = notin,hass,nd,alle,als,ist,lief,maschine,negativ,oder,positiv,sie,tage,re-use

# Generated by `flux install --export`; regenerated on every Flux upgrade, so
# fixing its prose upstream-style would just be reverted.
skip = *gotk-components.yaml
