    {
      "type": "bargauge",
      "title": "Am vollsten — Filesystems & PVCs",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Hosts und Kubernetes-Volumes in einer Liste, weil beides auf dieselbe Weise wehtut.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "topk(8, 100 - 100 * node_filesystem_avail_bytes{job=\"node-exporter\",fstype=~\"ext4|xfs|zfs|btrfs\"} / node_filesystem_size_bytes{job=\"node-exporter\",fstype=~\"ext4|xfs|zfs|btrfs\"})",
          "refId": "A",
          "range": false,
          "instant": true,
          "legendFormat": "{{instance}} {{mountpoint}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "topk(8, 100 * kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes)",
          "refId": "B",
          "range": false,
          "instant": true,
          "legendFormat": "pvc {{namespace}}/{{persistentvolumeclaim}}"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "sortBy": "Value",
        "sortOrder": "Descending",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
