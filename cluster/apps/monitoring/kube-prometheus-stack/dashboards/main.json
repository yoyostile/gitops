    {
      "type": "timeseries",
      "title": "CPU-Temperatur (heißester Sensor je Host)",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Der Join auf node_hwmon_sensor_label ist nötig, damit AMD (k10temp: Tctl/Tccd) und Intel (coretemp: Package id/Core) nebeneinander funktionieren — ein Chip-Filter erwischt immer nur eine der beiden Sorten.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"node-exporter\"} * on(chip,sensor,instance) group_left(label) node_hwmon_sensor_label{label=~\"Tctl|Tccd.*|Package id.*|Core.*\"})",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
