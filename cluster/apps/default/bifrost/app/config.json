{
  "$schema": "https://www.getbifrost.ai/schema",
  "source_of_truth": "config.json",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "initial_pool_size": 10,
    "drop_excess_requests": false,
    "enable_logging": true,
    "disable_content_logging": false,
    "log_retention_days": 90,
    "enforce_auth_on_inference": true,
    "allow_direct_keys": false
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD"
    },
    "virtual_keys": [
      {
        "id": "vk-reimbursat0r-invoice",
        "name": "reimbursat0r-invoice",
        "description": "Invoice extraction. Lyceum Llama-3.3-70B (EU) active; ollama kept as rollback. NOTE: invoice OCR text now leaves the LAN - the earlier local-only guarantee no longer holds for this path.",
        "value": "env.BIFROST_VK_INVOICE",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "allowed_models": ["qwen2.5:7b-32k", "qwen2.5:14b-32k"],
            "key_ids": ["*"]
          },
          {
            "provider": "lyceum",
            "allowed_models": ["meta-llama/Llama-3.3-70B-Instruct"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-reimbursat0r-notice",
        "name": "reimbursat0r-notice",
        "description": "Bescheid line-item extraction. Lyceum Qwen3-235B only.",
        "value": "env.BIFROST_VK_NOTICE",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "lyceum",
            "allowed_models": ["Qwen/Qwen3-235B-A22B-Instruct-2507"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-notgroschen",
        "name": "notgroschen",
        "description": "notgroschen merchant classification and taxonomy proposal. Sees merchant NAMES only - never transactions, amounts or IBANs. Lyceum Qwen3-235B only (EU-hosted); the data is personal banking, so it must not route outside the EU.",
        "value": "env.BIFROST_VK_NOTGROSCHEN",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "lyceum",
            "allowed_models": ["Qwen/Qwen3-235B-A22B-Instruct-2507"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-general-openai-eu",
        "name": "general-openai-eu",
        "description": "General-purpose key for OpenAI on the EU residency endpoint. Not wired to reimbursat0r - the invoice path stays ollama-only. Models are unrestricted here because the boundary worth enforcing is the provider, not the model list; a spend cap does the rest.",
        "value": "env.BIFROST_VK_GENERAL",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "openai",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-general-lyceum",
        "name": "general-lyceum",
        "description": "General-purpose key for Lyceum serverless inference (Berlin, EU residency, open-weight models). Own key rather than sharing the OpenAI one so spend and blast radius stay separate. Not wired to reimbursat0r.",
        "value": "env.BIFROST_VK_LYCEUM",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "lyceum",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-paperless-ai",
        "name": "paperless-ai",
        "description": "Paperless-ngx built-in AI: suggestions (tool-calling chat) plus RAG embeddings. Lyceum only, so document text stays with the EU provider. Presented as Authorization: Bearer because llama_index's OpenAILike cannot send x-bf-vk.",
        "value": "env.BIFROST_VK_PAPERLESS",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "lyceum",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "tensorx",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-zettelrobbe",
        "name": "zettelrobbe",
        "description": "Zettelrobbe (Paperless-AI fork) bulk tagging and vision OCR. Lyceum only. When adding a VK, its env var must also be added to deployment.yaml - an unresolved env. reference yields an empty value and the VK fails to create.",
        "value": "env.BIFROST_VK_ZETTELROBBE",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "lyceum",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "tensorx",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-general-tensorx",
        "name": "general-tensorx",
        "description": "TensorX (EU, Scaleway FR). Second EU provider alongside Lyceum; carries qwen3-vl-235b which Lyceum lacks.",
        "value": "env.BIFROST_VK_TENSORX",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "tensorx",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-general-openrouter",
        "name": "general-openrouter",
        "description": "General-purpose OpenRouter access. Prices come from Bifrost's automatically synchronized model catalog; isolated behind its own virtual key and monthly budget.",
        "value": "env.BIFROST_VK_OPENROUTER",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "openrouter",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-general-hetzner",
        "name": "general-hetzner",
        "description": "Hetzner experimental inference in Germany. The current catalog is free, so no paid pricing overrides or spend budget apply yet. Isolated behind its own virtual key.",
        "value": "env.BIFROST_VK_HETZNER",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "hetzner",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-hermes",
        "name": "hermes",
        "description": "Hermes Agent pilot. TensorX and Lyceum remain the EU primary/fallback; Hetzner's experimental German endpoint and OpenRouter are also available for manual selection. OpenRouter traffic may leave Europe. Isolated and capped independently.",
        "value": "env.BIFROST_VK_HERMES",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "tensorx",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "lyceum",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "openrouter",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "hetzner",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-eval",
        "name": "eval",
        "description": "Benchmarking only, spans every provider so one run can compare local vs Anthropic vs EU clouds. Deliberately NOT in any Deployment env - pass it ad hoc (kubectl exec -- env EVAL_BIFROST_VK=...) so no long-running pod holds a key this broad.",
        "value": "env.BIFROST_VK_EVAL",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "anthropic",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "openai",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "lyceum",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "tensorx",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "openrouter",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "hetzner",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      }
    ],
