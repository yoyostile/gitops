{
  "$schema": "https://www.getbifrost.ai/schema",
  "source_of_truth": "config.json",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "initial_pool_size": 10,
    "drop_excess_requests": false,
    "enable_logging": true,
    "disable_content_logging": false,
    "log_retention_days": 90,
    "enforce_auth_on_inference": true,
    "allow_direct_keys": false
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD"
    },
    "virtual_keys": [
      {
        "id": "vk-reimbursat0r-invoice",
        "name": "reimbursat0r-invoice",
        "description": "Invoice extraction. Ollama only - PHI cannot reach a cloud provider with this key, whatever the caller asks for.",
        "value": "env.BIFROST_VK_INVOICE",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "allowed_models": ["qwen2.5:7b-32k", "qwen2.5:14b-32k"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-reimbursat0r-notice",
        "name": "reimbursat0r-notice",
        "description": "Bescheid line-item extraction. Anthropic Sonnet only.",
        "value": "env.BIFROST_VK_NOTICE",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "anthropic",
            "allowed_models": ["claude-sonnet-4-6"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-general-openai-eu",
        "name": "general-openai-eu",
        "description": "General-purpose key for OpenAI on the EU residency endpoint. Not wired to reimbursat0r - the invoice path stays ollama-only. Models are unrestricted here because the boundary worth enforcing is the provider, not the model list; a spend cap does the rest.",
        "value": "env.BIFROST_VK_GENERAL",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "openai",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-general-lyceum",
        "name": "general-lyceum",
        "description": "General-purpose key for Lyceum serverless inference (Berlin, EU residency, open-weight models). Own key rather than sharing the OpenAI one so spend and blast radius stay separate. Not wired to reimbursat0r.",
        "value": "env.BIFROST_VK_LYCEUM",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "lyceum",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      },
      {
        "id": "vk-eval",
        "name": "eval",
        "description": "Benchmarking only, spans every provider so one run can compare local vs Anthropic vs EU clouds. Deliberately NOT in any Deployment env - pass it ad hoc (kubectl exec -- env EVAL_BIFROST_VK=...) so no long-running pod holds a key this broad.",
        "value": "env.BIFROST_VK_EVAL",
        "is_active": true,
        "provider_configs": [
          { "provider": "ollama", "allowed_models": ["*"], "key_ids": ["*"] },
          {
            "provider": "anthropic",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          { "provider": "openai", "allowed_models": ["*"], "key_ids": ["*"] },
          { "provider": "lyceum", "allowed_models": ["*"], "key_ids": ["*"] }
        ]
      }
    ],
    "budgets": [
      {
        "id": "budget-eval",
        "virtual_key_id": "vk-eval",
        "max_limit": 15,
        "reset_duration": "1M"
      },
      {
        "id": "budget-general-openai-eu",
        "virtual_key_id": "vk-general-openai-eu",
        "max_limit": 25,
        "reset_duration": "1M"
      },
      {
        "id": "budget-general-lyceum",
        "virtual_key_id": "vk-general-lyceum",
        "max_limit": 25,
        "reset_duration": "1M"
      }
    ]
  },
  "providers": {
    "ollama": {
      "keys": [
        {
          "name": "sn0w",
          "weight": 1,
          "models": ["*"],
          "ollama_key_config": {
            "url": "env.OLLAMA_URL"
          }
        }
      ],
      "network_config": {
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 900,
        "max_retries": 0
      },
      "concurrency_and_buffer_size": {
        "concurrency": 1,
        "buffer_size": 10
      }
    },
    "anthropic": {
      "keys": [
        {
          "name": "anthropic-primary",
          "value": "env.ANTHROPIC_API_KEY",
          "weight": 1,
          "models": ["*"]
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 2
      }
    },
    "openai": {
      "keys": [
        {
          "name": "openai-eu",
          "value": "env.OPENAI_API_KEY",
          "weight": 1,
          "models": ["*"]
        }
      ],
      "network_config": {
        "base_url": "https://eu.api.openai.com",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 2
      }
    },
    "lyceum": {
      "keys": [
        {
          "name": "lyceum",
          "value": "env.LYCEUM_API_KEY",
          "weight": 1,
          "models": ["*"]
        }
      ],
      "network_config": {
        "base_url": "https://api.lyceum.technology",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 2
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "request_path_overrides": {
          "chat_completion": "/api/v2/external/serverless/chat/completions",
          "chat_completion_stream": "/api/v2/external/serverless/chat/completions",
          "list_models": "/api/v2/external/serverless/models",
          "embedding": "/api/v2/external/serverless/embeddings"
        },
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true,
          "list_models": true,
          "embedding": true
        }
      }
    }
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/logs.db"
    }
  }
}
