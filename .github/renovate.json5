{
  enabled: true,
  semanticCommits: 'enabled',
  dependencyDashboard: {
    enabled: true,
    title: 'Renovate Dashboard',
  },
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  schedule: [
    'every weekend',
  ],
  'pre-commit': {
    enabled: true,
  },
  flux: {
    managerFilePatterns: [
      '/cluster/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/cluster/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/cluster/.+\\.ya?ml$/',
      '/provision/ansible/playbooks/templates/.+\\.ya?ml.j2$/',
    ],
  },
  nix: {
    enabled: true,
    lockFileMaintenance: {
      enabled: true,
      schedule: [
        '* 0-5 * * 0',
      ],
    },
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Process CRD dependencies',
      managerFilePatterns: [
        '/cluster/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>\\S+) chart=(?<depName>\\S+)\n.*?(?<currentValue>[^-\\s]*)\n',
        'datasource=(?<datasource>\\S+) image=(?<depName>\\S+)\n.*?-\\s(.*?)/(?<currentValue>[^/]+)/[^/]+\n',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}helm{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Process various dependencies',
      managerFilePatterns: [
        '/ansible/.+\\.ya?ml$/',
        '/cluster/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?"(?<currentValue>.*)"\n',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Process raw GitHub URLs',
      managerFilePatterns: [
        '/cluster/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'https:\\/\\/raw.githubusercontent.com\\/(?<depName>[\\w\\d\\-_]+\\/[\\w\\d\\-_]+)\\/(?<currentValue>[\\w\\d\\.\\-_]+)\\/.*',
      ],
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?)\n *chart: (?<depName>.*?)\n *version: (?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/cert-manager/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?) chart=(?<depName>.*?)\n.*\\/(?<currentValue>.*?)\\/',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/crds/traefik/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'registryUrl=(?<registryUrl>.*?) chart=(?<depName>.*?)\n *tag: v(?<currentValue>.*)\n',
      ],
      datasourceTemplate: 'helm',
    },
    {
      customType: 'regex',
      description: 'Container images in NixOS oci-containers',
      managerFilePatterns: [
        '/nix/.+\\.nix$/',
      ],
      matchStrings: [
        'image = "(?<depName>[^":@]+):(?<currentValue>[^"@]+)@(?<currentDigest>sha256:[a-f0-9]+)";',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      matchDatasources: [
        'helm',
      ],
      separateMinorPatch: true,
      ignoreDeprecated: true,
    },
    {
      matchDatasources: [
        'docker',
      ],
      enabled: true,
      commitMessageTopic: 'container image {{depName}}',
      commitMessageExtra: 'to {{#if isSingleVersion}}v{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}',
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'renovate/image',
        'dep/major',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'renovate/image',
        'dep/minor',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'renovate/image',
        'dep/patch',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '!ghcr.io/yoyostile/**',
        '!yoyostile/**',
        '!docker.io/yoyostile/**',
      ],
      pinDigests: true,
      minimumReleaseAge: '3 days',
      minimumReleaseAgeBehaviour: 'timestamp-optional',
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'renovate/helm',
        'dep/major',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      labels: [
        'renovate/helm',
        'dep/minor',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      labels: [
        'renovate/helm',
        'dep/patch',
      ],
    },
    {
      matchDatasources: [
        'docker',
        'github-releases',
      ],
      versioning: 'loose',
      matchPackageNames: [
        'ghcr.io/onedr0p/plex',
        'lscr.io/linuxserver/plex',
        'ghcr.io/immich-app/immich-server',
      ],
    },
    {
      matchDatasources: [
        'github-releases',
      ],
      matchPackageNames: [
        'fluxcd/flux2',
      ],
      extractVersion: '^v(?<version>.+)$',
    },
    {
      matchPackageNames: [
        '*',
      ],
      allowedVersions: '!/[-.](alpha|beta|rc|pre|preview|nightly)\\.?\\d*$/i',
    },
    {
      matchDatasources: [
        'docker',
      ],
      versioning: 'regex:^RELEASE\\.(?<major>\\d+)-(?<minor>\\d+)-(?<patch>\\d+)T.*Z(-(?<compatibility>.*))?$',
      matchPackageNames: [
        'quay.io/minio/minio',
        'quay.io/minio/mc',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      versioning: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
      matchPackageNames: [
        'docker.io/maximhq/bifrost',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-nbxyz(?<build>\\d+)$',
      matchPackageNames: [
        'ghcr.io/netbootxyz/netbootxyz',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'lscr.io/linuxserver/lidarr',
      ],
      allowedVersions: '!/^8\\./',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'docker.io/library/rabbitmq',
        'docker.io/library/redis',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'nix',
      ],
      matchDepNames: [
        'nixpkgs',
      ],
      commitMessageTopic: 'nixpkgs channel',
      labels: [
        'renovate/nix',
        'dep/major',
      ],
      automerge: false,
    },
    {
      matchManagers: [
        'nix',
      ],
      matchUpdateTypes: [
        'lockFileMaintenance',
      ],
      labels: [
        'renovate/nix',
        'dep/patch',
      ],
      automerge: false,
    },
  ],
}
